# NetRush settings for the server at the arena. Copy this file to .env (same folder) and fill it in.
# After any change: run deploy\windows\restart.cmd. Never share .env (it holds passwords and keys).

FACILITY_NAME=NetRush
PUBLIC_URL=https://netrush.in
PORT=8000

# Behind Netlify + Cloudflare Tunnel: the visitor's real address arrives in this header (rate limits)
CLIENT_IP_HEADER=X-Nf-Client-Connection-Ip

# ---------- Staff logins (created on the first start; later changes in Admin > Team & health)
ADMIN_PHONE=
ADMIN_PASSWORD=
RECEPTION_PHONE=
RECEPTION_PASSWORD=

# ---------- Event / party enquiries from the website: always in Admin > Events; also sent to this
# staff mobile if set (WhatsApp template "event_enquiry", or SMS via MSG91_FLOW_EVENT)
EVENT_NOTIFY_PHONE=
EVENT_NOTIFY_CHANNEL=whatsapp

# ---------- Arena details (landing page, reservations, messages)
ARENA_PHONE=+91
ARENA_ADDRESS=NetRush Arena, <street>, <city>
ARENA_MAPS_URL=
ARENA_INSTAGRAM=

# ---------- Courts, prices and rules
OPEN_HOUR=6
CLOSE_HOUR=23
SLOT_MIN=60
PRICE_BADMINTON=1000
PRICE_PADEL=1800
PRICE_PICKLEBALL=500
ONLINE_MEMBERSHIP_MONTHLY=2000
ONLINE_MEMBERSHIP_MONTHS=1,3,6
RESERVE_HOLD_HOURS=3
RESERVE_MIN_LEAD_MIN=60
FIRST_BOOKING_DISCOUNT_PCT=15
REFERRAL_REWARD=300
REFUND_FULL_HOURS=24
REFUND_PARTIAL_HOURS=6
REFUND_PARTIAL_PCT=50
REMINDER_DAYS=7,0
REMINDER_HOUR=10

# ---------- Door: ZKTeco MiniAC Plus
# Members (monthly / club membership) enter by face. Guests type the door code they receive
# DOOR_CODE_LEAD_MIN minutes before their slot; it works until the slot ends.
LOCK_ENABLED=1
LOCK_PROVIDER=zkteco
ZK_IP=192.168.1.201
ZK_PORT=4370
ZK_COMM_KEY=0
# Access groups set up once on the terminal: 1 = may enter, 2 = no access time (lapsed members)
ZK_ACTIVE_GROUP=1
ZK_BLOCKED_GROUP=2
DOOR_CODE_LEAD_MIN=10
DOOR_CODE_AT_BOOKING=0
DOOR_CODE_GRACE_MIN=0
# What the door-code message tells guests to do. Confirm the exact keypad steps on your terminal.
DOOR_KEYPAD_STEPS=At the door keypad type the code, press OK, then type it again and press OK.
# 1 = academy players with paid fees also get face entry
ACADEMY_DOOR_ACCESS=0
# Only for a door controller that calls this server itself (not needed for the ZKTeco terminal)
LOCK_AUTH=hmac
LOCK_ALLOWED_IPS=
DEVICE_SECRET=

# ---------- Messages. Each customer picks WhatsApp OR SMS and gets everything once, on that one.
# Used when someone hasn't chosen:
DEFAULT_CHANNEL=whatsapp

# WhatsApp Cloud API (Meta). Business-initiated messages must use approved templates.
WHATSAPP_PROVIDER=console
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_LANG=en
WA_TPL_DOOR_CODE=door_code
WA_TPL_BOOKING=booking_confirmed
WA_TPL_MEMBERSHIP=membership_reminder
WA_TPL_ACADEMY=academy_fee_reminder
WA_TPL_LOGIN=login_otp
WA_TPL_CANCELLED=booking_cancelled
WA_TPL_REFUND=refund_issued
WA_TPL_MEMBERSHIP_OK=membership_confirmed
# Other messages use a template with the same name as the message: reservation_received,
# reservation_released, referral_reward.

# SMS through MSG91: login codes, guests' door codes and booking messages. Each SMS type needs its own
# DLT-approved template and an MSG91 "flow" (DEPLOY.md step 5). A type with no flow ID goes by WhatsApp instead.
SMS_PROVIDER=msg91
MSG91_AUTHKEY=
# the four that matter most
MSG91_FLOW_LOGIN=
MSG91_FLOW_DOOR_CODE=
MSG91_FLOW_BOOKING=
MSG91_FLOW_RESERVED=
# the rest (optional)
MSG91_FLOW_CANCELLED=
MSG91_FLOW_RELEASED=
MSG91_FLOW_REFUND=
MSG91_FLOW_MEMBERSHIP=
MSG91_FLOW_MEMBERSHIP_OK=
MSG91_FLOW_ACADEMY=
MSG91_FLOW_REFERRAL=
MSG91_FLOW_EVENT=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# ---------- Payments: none ("Pay now" hidden, pay at the venue) | razorpay
PAYMENT_PROVIDER=none
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay > Webhooks > event payment.captured, URL https://netrush.in/api/payments/razorpay-webhook
RAZORPAY_WEBHOOK_SECRET=

# ---------- Backups: a copy of the database every day. Point this at a Google Drive / OneDrive
# folder (or a USB drive) so a dead laptop doesn't take the data with it.
BACKUP_DIR=
BACKUP_KEEP_DAYS=30
